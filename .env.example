# Civitai API — https://civitai.com/user/account → API Keys
# Search works without a token; downloads require Bearer token.
CIVITAI_API_TOKEN=

# Safety — dry_run skips writing weight files
CIVITAI_DRY_RUN=1
CIVITAI_REQUIRE_DOWNLOAD_APPROVAL=1

# Depot for downloaded weights (ComfyUI / comfyops layout: checkpoints/, loras/, …)
# Defaults to COMFYOPS_MODELS_DIR or COMFYUI_MODELS_DIR if set, else ./data/models
# CIVITAI_DEPOT_DIR=D:\ComfyUI\models
# COMFYOPS_MODELS_DIR=D:\ComfyUI\models

CIVITAI_BACKEND_PORT=11124
# Frontend Vite: 11125

# Include NSFW in search (default off)
CIVITAI_NSFW=0
