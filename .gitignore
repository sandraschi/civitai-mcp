# Fleet .gitignore — see mcp-central-docs/standards/GITIGNORE_STANDARDS.md

# Python
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# Node / webapp
node_modules/
**/node_modules/
webapp/node_modules/
webapp/dist/
*.tsbuildinfo

# Rust / Tauri (never push these)
target/
**/target/
src-tauri/target/
src-tauri/binaries/
src-tauri/resources/*.exe
src-tauri/gen/
gen/

# Build
dist/
build/
*.mcpb
mcpb/src/

# Data / DB
data/
*.db
*.db-shm
*.db-wal
*.sqlite3

# Secrets
.env
.env.*
!.env.example
*.pem

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs / reports / backups
*.log
logs/
reports/
*.bak
*.bak.*

webapp/test-results/


webapp/test-results/


webapp/test-results/


webapp/test-results/
